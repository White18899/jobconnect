{
  "name": "jobconnect",
  "version": "1.0.0",
  "description": "JobConnect - India's Blue-Collar Employment Platform with Cloudflare Workers Backend and Vanilla HTML/CSS/JS Frontend",
  "private": true,
  "scripts": {
    "start": "npx serve public -p 3000",
    "dev": "npx serve public -p 3000",
    "deploy:frontend": "wrangler pages deploy public --project-name=jobconnect-frontend",
    "backend:dev": "cd backend && npm run dev",
    "backend:build": "cd backend && npm run build",
    "backend:deploy": "cd backend && npm run deploy",
    "backend:migrate": "cd backend && npm run db:migrate:remote"
  },
  "devDependencies": {
    "serve": "^14.2.4",
    "wrangler": "^3.101.0"
  }
}
